<Window x:Class="WpfApp2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfApp2"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <Button Content="Button" HorizontalAlignment="Left" 
                Margin="148,253,0,0" VerticalAlignment="Top" Click="Button_Click"/>
        <TextBlock x:Name="startX_Text_Block" HorizontalAlignment="Left" 
                   Margin="148,99,0,0" TextWrapping="Wrap" Text="Startx" VerticalAlignment="Top"/>
        <TextBlock x:Name="EndX_Text_Block" HorizontalAlignment="Left" 
                   Margin="148,141,0,0" TextWrapping="Wrap" Text="EndX" VerticalAlignment="Top"/>
        <TextBlock x:Name="StartY_Text_block" HorizontalAlignment="Left" 
                   Margin="148,182,0,0" TextWrapping="Wrap" Text="StartY" VerticalAlignment="Top"/>
        <TextBlock x:Name="EndY_Text_Block" HorizontalAlignment="Left" 
                   Margin="148,217,0,0" TextWrapping="Wrap" Text="EndY" VerticalAlignment="Top"/>
        <TextBox x:Name="StartX_Input_box" HorizontalAlignment="Left" 
                 Margin="218,99,0,0" TextWrapping="Wrap" Text="0,0" VerticalAlignment="Top" Width="120" TextChanged="StartX_Input_box_TextChanged"/>
        <TextBox x:Name="EndY_Input_box" HorizontalAlignment="Left" 
                 Margin="218,216,0,0" TextWrapping="Wrap" Text="1,0" VerticalAlignment="Top" Width="120" TextChanged="EndY_Input_box_TextChanged"/>
        <TextBox x:Name="StartY_Input_box" HorizontalAlignment="Left" 
                 Margin="218,180,0,0" TextWrapping="Wrap" Text="-1,0" VerticalAlignment="Top" Width="120" TextChanged="StartY_Input_box_TextChanged"/>
        <TextBox x:Name="EndX_Input_box" HorizontalAlignment="Left" 
                 Margin="218,141,0,0" TextWrapping="Wrap" Text="13,0" VerticalAlignment="Top" Width="120" TextChanged="EndX_Input_box_TextChanged"/>
        <TextBlock x:Name="InfixExpression_Text_Block" HorizontalAlignment="Left" 
                   Margin="127,68,0,0" TextWrapping="NoWrap" Text="Infix Expression" VerticalAlignment="Top"/>
        <TextBox x:Name="InfixExpression_Input_Box" HorizontalAlignment="Left" 
                 Margin="218,67,0,0" TextWrapping="NoWrap" Text="sin(x)" VerticalAlignment="Top" Width="120" TextChanged="InfixExpression_Input_Box_TextChanged"/>
        <TextBlock x:Name="EndX_Error_Block" HorizontalAlignment="Left" 
                   Margin="183,159,0,0" TextWrapping="NoWrap" VerticalAlignment="Top"  RenderTransformOrigin="-1.296,0.587"/>
        <TextBlock x:Name="StartY_Error_Block" HorizontalAlignment="Left" 
                   Margin="229,200,0,0" TextWrapping="NoWrap" VerticalAlignment="Top" RenderTransformOrigin="-1.296,0.587" Width="3">
            <TextBlock.RenderTransform>
                <TransformGroup>
                    <ScaleTransform ScaleX="-1"/>
                    <SkewTransform/>
                    <RotateTransform/>
                    <TranslateTransform/>
                </TransformGroup>
            </TextBlock.RenderTransform>
        </TextBlock>
        <TextBlock x:Name="Expression_Error_Block" HorizontalAlignment="Left" 
                   Margin="222,86,0,0" TextWrapping="NoWrap" VerticalAlignment="Top" RenderTransformOrigin="-1.296,0.587"/>
        <TextBlock x:Name="StartX_Error_Block" HorizontalAlignment="Left" 
                   Margin="220,122,0,0" TextWrapping="NoWrap" VerticalAlignment="Top" RenderTransformOrigin="-1.296,0.587"/>
        <TextBlock x:Name="EndY_Error_Block" HorizontalAlignment="Left" 
                   Margin="222,247,0,0" TextWrapping="NoWrap" VerticalAlignment="Top" />
    </Grid>
</Window>
